# Copy this file to .env (gitignored) and fill in real values before running bin/setup.sh

# Site
PROJECT_TITLE="WP Idea"
PROJECT_URL="https://wp-idea.ddev.site"

# wp-admin user created by `wp core install`
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me-please
WP_ADMIN_EMAIL=you@example.com

# Custom DB table prefix (matches the base theme's wp-config convention)
DB_TABLE_PREFIX=rb_

# ACF PRO
# Get this from your account at https://www.advancedcustomfields.com/my-account/
# NEVER commit a real key. bin/setup.sh downloads the plugin zip using this key
# via ACF's own update-connect endpoint, the same one the plugin's built-in
# updater uses.
ACF_PRO_KEY=

# Optional integrations wired up by the base theme (safe to leave blank locally)
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
GTM_TAG=
